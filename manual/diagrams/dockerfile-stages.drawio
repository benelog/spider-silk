<mxfile host="drawio" type="device"><diagram name="dockerfile-stages" id="dockerfile-stages"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;COPY the build scripts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#6b7280&quot;&gt;gradlew, settings.gradle, build.gradle, gradle/, every module's build.gradle, and the spider-silk-gradle-plugin included build&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f3f4f6;strokeColor=#8a93a6;" vertex="1" parent="1"><mxGeometry x="35" y="70" width="300" height="70" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;RUN gradlew :example-flashcard:resolveDependencies&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#6b7280&quot;&gt;downloads the external runtime jars: the dependency-cache layer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fdece6;strokeColor=#e2603f;" vertex="1" parent="1"><mxGeometry x="35" y="174" width="300" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;COPY the sources&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#6b7280&quot;&gt;spider-silk-core/src, example-flashcard/src&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f3f4f6;strokeColor=#8a93a6;" vertex="1" parent="1"><mxGeometry x="35" y="278" width="300" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;RUN gradlew :example-flashcard:installDist&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#6b7280&quot;&gt;compiles, precompiles the templates, assembles lib/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fdece6;strokeColor=#e2603f;" vertex="1" parent="1"><mxGeometry x="35" y="382" width="300" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Sort lib/ into tiers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#6b7280&quot;&gt;/layers/dependencies: the external jars&lt;br&gt;/layers/core: the spider-silk jars&lt;br&gt;the application's own jar is discarded&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f3f4f6;strokeColor=#8a93a6;" vertex="1" parent="1"><mxGeometry x="35" y="486" width="300" height="84" as="geometry"/></mxCell><mxCell id="c7" value="Stage 1: build   &lt;font style=&quot;font-size: 11px&quot; color=&quot;#6b7280&quot;&gt;FROM eclipse-temurin:25-jdk&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#8a93a6;fontSize=11;fontStyle=1;fontColor=#4b5563;align=left;verticalAlign=top;spacingLeft=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="330" height="600" as="geometry"/></mxCell><mxCell id="c8" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#2b303b;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185.0" y="140" as="sourcePoint"/><mxPoint x="185.0" y="174" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#2b303b;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185.0" y="244" as="sourcePoint"/><mxPoint x="185.0" y="278" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#2b303b;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185.0" y="348" as="sourcePoint"/><mxPoint x="185.0" y="382" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#2b303b;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185.0" y="452" as="sourcePoint"/><mxPoint x="185.0" y="486" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="↓ a build-script edit invalidates from here" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=bottom;whiteSpace=wrap;fontColor=#b45309;" vertex="1" parent="1"><mxGeometry x="35" y="38" width="300" height="30" as="geometry"/></mxCell><mxCell id="c13" value="↓ a source edit invalidates from here" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=bottom;whiteSpace=wrap;fontColor=#b45309;" vertex="1" parent="1"><mxGeometry x="35" y="246" width="140.0" height="30" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;COPY --from=build /layers/dependencies  lib/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#6b7280&quot;&gt;the external jars: least volatile&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#eaf6ee;strokeColor=#4f9d69;" vertex="1" parent="1"><mxGeometry x="485" y="70" width="300" height="70" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;COPY --from=build /layers/core  lib/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#6b7280&quot;&gt;the spider-silk jars: an application pulling spider-silk from a repository has no such tier&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#eaf6ee;strokeColor=#4f9d69;" vertex="1" parent="1"><mxGeometry x="485" y="174" width="300" height="70" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;COPY --from=build build/resources/main  resources/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#6b7280&quot;&gt;templates as compiled classes, static files, schema.sql&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#eaf6ee;strokeColor=#4f9d69;" vertex="1" parent="1"><mxGeometry x="485" y="278" width="300" height="70" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;COPY --from=build build/classes/java/main  classes/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#6b7280&quot;&gt;loose .class files, not a jar: unchanged bytecode is unchanged content, and a code edit rewrites this layer alone&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#eaf6ee;strokeColor=#4f9d69;" vertex="1" parent="1"><mxGeometry x="485" y="382" width="300" height="70" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;ENTRYPOINT java -cp /app/resources:/app/classes:/app/lib/* flashcard.FlashcardApp&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#6b7280&quot;&gt;EXPOSE 8080; H2 writes under /root/db&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f3f4f6;strokeColor=#8a93a6;" vertex="1" parent="1"><mxGeometry x="485" y="486" width="300" height="70" as="geometry"/></mxCell><mxCell id="c19" value="Stage 2: runtime   &lt;font style=&quot;font-size: 11px&quot; color=&quot;#6b7280&quot;&gt;FROM eclipse-temurin:25-jre&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#8a93a6;fontSize=11;fontStyle=1;fontColor=#4b5563;align=left;verticalAlign=top;spacingLeft=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="470" y="20" width="330" height="586" as="geometry"/></mxCell><mxCell id="c20" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#2b303b;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635.0" y="140" as="sourcePoint"/><mxPoint x="635.0" y="174" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#2b303b;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635.0" y="244" as="sourcePoint"/><mxPoint x="635.0" y="278" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#2b303b;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635.0" y="348" as="sourcePoint"/><mxPoint x="635.0" y="382" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#2b303b;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635.0" y="452" as="sourcePoint"/><mxPoint x="635.0" y="486" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="↓ least volatile" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=bottom;whiteSpace=wrap;fontColor=#b45309;" vertex="1" parent="1"><mxGeometry x="485" y="38" width="300" height="30" as="geometry"/></mxCell><mxCell id="c25" value="↑ most volatile" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=bottom;whiteSpace=wrap;fontColor=#b45309;" vertex="1" parent="1"><mxGeometry x="485" y="454" width="140.0" height="30" as="geometry"/></mxCell><mxCell id="c26" value="COPY --from=build" style="html=1;endArrow=block;endFill=1;strokeColor=#2b303b;fontSize=11;fontFamily=Helvetica;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="50" as="sourcePoint"/><mxPoint x="470" y="50" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="Docker caches the instructions as a chain, so an edit rewrites its own tier and every tier after it. Jib builds the same four layers from the Gradle model, independent of one another and with no daemon." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fff9e6;strokeColor=#d9b64a;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="780" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>