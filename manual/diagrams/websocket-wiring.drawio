<mxfile host="drawio" type="device"><diagram name="websocket-wiring" id="websocket-wiring"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Your application&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size: 10px&quot;&gt;new App()&lt;br&gt;&amp;nbsp;&amp;nbsp;.get(&quot;/&quot;, req -&amp;gt; ...)&lt;br&gt;&amp;nbsp;&amp;nbsp;.server((app, port) -&amp;gt; new JettyServer(app).port(port)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;.customizeServer(new WebSockets()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;.at(&quot;/echo&quot;, (req, res) -&amp;gt; new EchoSocket())))&lt;br&gt;&amp;nbsp;&amp;nbsp;.start(8080);&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fillColor=#e8f0fa;strokeColor=#4c78b5;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="360" height="130" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;JettyServer.start()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#6b7280&quot;&gt;builds the Server and a ServletContextHandler with AppServlet at /*, runs customizeContext, then customizeServer, then starts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;fillColor=#fdece6;strokeColor=#e2603f;" vertex="1" parent="1"><mxGeometry x="20" y="270" width="360" height="74" as="geometry"/></mxCell><mxCell id="c4" value="start(8080)" style="html=1;endArrow=block;endFill=1;strokeColor=#2b303b;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="230" as="sourcePoint"/><mxPoint x="200" y="270" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c5" value="&lt;b&gt;WebSockets.accept(server)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#6b7280&quot;&gt;finds the ServletContextHandler under the Server and inserts a WebSocketUpgradeHandler ahead of the servlet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;fillColor=#fdece6;strokeColor=#e2603f;" vertex="1" parent="1"><mxGeometry x="20" y="384" width="360" height="74" as="geometry"/></mxCell><mxCell id="c6" value="customizeServer(...)" style="html=1;endArrow=block;endFill=1;strokeColor=#2b303b;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="344" as="sourcePoint"/><mxPoint x="200" y="384" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c7" value="&lt;b&gt;GET /echo&lt;/b&gt;&lt;br&gt;Upgrade: websocket" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;fillColor=#ffffff;strokeColor=#2b303b;" vertex="1" parent="1"><mxGeometry x="440" y="20" width="140" height="50" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;GET /&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;fillColor=#ffffff;strokeColor=#2b303b;" vertex="1" parent="1"><mxGeometry x="590" y="20" width="130" height="50" as="geometry"/></mxCell><mxCell id="c9" value="Jetty handler chain, after start" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#8a93a6;fontSize=11;fontStyle=1;fontColor=#4b5563;align=left;verticalAlign=top;spacingLeft=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="430" y="100" width="300" height="480" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#6b7280&quot;&gt;the connector, the buffer pool, the executor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;fillColor=#f3f4f6;strokeColor=#8a93a6;" vertex="1" parent="1"><mxGeometry x="450" y="134" width="260" height="64" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;ServletContextHandler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#6b7280&quot;&gt;sessions, the context path&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;fillColor=#f3f4f6;strokeColor=#8a93a6;" vertex="1" parent="1"><mxGeometry x="450" y="234" width="260" height="64" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;WebSocketUpgradeHandler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#6b7280&quot;&gt;mappings: /echo → factory&lt;br&gt;GET /echo matches: upgraded and answered here, the servlet never runs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;fillColor=#fdece6;strokeColor=#e2603f;" vertex="1" parent="1"><mxGeometry x="450" y="334" width="260" height="76" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;ServletHandler → AppServlet /*&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#6b7280&quot;&gt;GET / has no mapping and falls through unchanged:&lt;br&gt;router, filters, error handlers, request logger&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;fillColor=#fdece6;strokeColor=#e2603f;" vertex="1" parent="1"><mxGeometry x="450" y="446" width="260" height="76" as="geometry"/></mxCell><mxCell id="c14" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#2b303b;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="70" as="sourcePoint"/><mxPoint x="550" y="134" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#2b303b;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="655" y="70" as="sourcePoint"/><mxPoint x="610" y="134" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#2b303b;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="198" as="sourcePoint"/><mxPoint x="580" y="234" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#2b303b;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="298" as="sourcePoint"/><mxPoint x="580" y="334" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#2b303b;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="410" as="sourcePoint"/><mxPoint x="580" y="446" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="inserts" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#2b303b;fontSize=11;fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="421" as="sourcePoint"/><mxPoint x="450" y="372.0" as="targetPoint"/><Array as="points"><mxPoint x="405" y="421"/><mxPoint x="405" y="372.0"/></Array></mxGeometry></mxCell><mxCell id="c20" value="What never sees a socket: the router and app.routes(), before and after filters, error(status, ...), the request logger, and WebTest. The upgrade leaves servlet dispatch for good." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fff9e6;strokeColor=#d9b64a;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="710" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>